# vim: set noexpandtab tabstop=4 shiftwidth=4 :
[alias]
	ocmmit = commit
	commie = commit
	co = checkout
	ci = commit
	tip = log -1
	pom = pull origin main
	pum = pull upstream main
[github]
	user = bobdoah
[log]
	date = iso
[user]
	name = Robert Williams
	email = 1266467+bobdoah@users.noreply.github.com
[core]
	ignorecase = false
